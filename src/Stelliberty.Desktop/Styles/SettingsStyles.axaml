<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia">

  <Style Selector="Button.accent-swatch">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Width="32" Height="32"
                CornerRadius="16"
                Background="{TemplateBinding Background}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1" />
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.accent-swatch:pointerover">
    <Setter Property="Opacity" Value="0.85" />
  </Style>

  <Style Selector="Border.surface-group">
    <Setter Property="Background" Value="{DynamicResource AppSettingsGroupBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="15" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BoxShadow" Value="{DynamicResource AppSurfaceRaisedShadow}" />
  </Style>

  <Style Selector="TextBlock.surface-group-title">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1" />
    <!-- 分组标题直接叠在窗口材质上，使用独立高对比度文字色。 -->
    <Setter Property="Foreground" Value="{DynamicResource AppSettingsGroupTitleBrush}" />
    <Setter Property="Margin" Value="8,8,0,10" />
  </Style>

  <Style Selector="Button.settings-row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="20,16" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.settings-row:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppOverlayBrush}" />
  </Style>
  <Style Selector="Button.settings-row.suppress-pointerover:pointerover">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.settings-row.suppress-pointerover:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.settings-row:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <Style Selector="Button.settings-row.first">
    <Setter Property="CornerRadius" Value="14,14,0,0" />
  </Style>
  <Style Selector="Button.settings-row.last">
    <Setter Property="CornerRadius" Value="0,0,14,14" />
  </Style>
  <Style Selector="Button.settings-row.only">
    <Setter Property="CornerRadius" Value="14" />
  </Style>

  <Style Selector="Border.settings-row-divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="20,0" />
    <Setter Property="Background" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="Opacity" Value="0.6" />
  </Style>

  <Style Selector="Border.settings-icon-badge">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Background" Value="{DynamicResource AppAccentSubtleBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="iconPacks|PackIconMingCuteIcons.settings-entry-icon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="iconPacks|PackIconMingCuteIcons.settings-theme-icon">
    <Setter Property="RenderTransform">
      <TranslateTransform X="1.5" />
    </Setter>
  </Style>
  <Style Selector="iconPacks|PackIconMingCuteIcons.settings-chevron">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextTertiaryBrush}" />
  </Style>
  <Style Selector="iconPacks|PackIconMingCuteIcons.settings-back-icon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
  </Style>

  <Style Selector="Border.settings-inline-row">
    <Setter Property="Padding" Value="20,14" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.settings-toggle-command">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.settings-toggle-command:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.settings-toggle-command:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="TextBlock.settings-row-title">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />

    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.settings-row-subtitle">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextTertiaryBrush}" />
  </Style>

  <Style Selector="TextBox.settings-input">
    <Setter Property="Background" Value="{DynamicResource AppInputBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBox.settings-input /template/ Border#PART_ContentPresenterBorder">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="TextBox.settings-input:pointerover /template/ Border#PART_ContentPresenterBorder">
    <Setter Property="Background" Value="{DynamicResource AppInputHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
  </Style>
  <Style Selector="TextBox.settings-input:focus /template/ Border#PART_ContentPresenterBorder">
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBorderBrush}" />
  </Style>

  <Style Selector="TextBox.settings-input.multiline">
    <Setter Property="MinHeight" Value="84" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="Button.settings-reset">
    <Setter Property="Background" Value="{DynamicResource AppInputBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="13,7" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
  </Style>
  <Style Selector="Button.settings-reset /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.settings-reset:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.settings-reset:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppInputHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBorderBrush}" />
  </Style>
  <Style Selector="Button.settings-reset:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppOverlayBrush}" />
  </Style>

  <Style Selector="Button.settings-icon-entry">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="17" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.settings-icon-entry /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.settings-icon-entry:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppOverlayBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.settings-icon-entry:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppOverlayBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <Style Selector="Border.surface-panel">
    <Setter Property="Background" Value="{DynamicResource AppCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="15" />
    <Setter Property="Padding" Value="20,14" />
    <Setter Property="BoxShadow" Value="{DynamicResource AppSurfaceRaisedShadow}" />
  </Style>

  <!-- list 修饰: 对话框/设置内列表项降到列表档阴影, 与节点卡片一致 -->
  <Style Selector="Border.surface-panel.list">
    <Setter Property="BoxShadow" Value="{DynamicResource AppSurfaceListShadow}" />
  </Style>

  <Style Selector="Button.about-link">
    <Setter Property="Padding" Value="16,15" />
    <Setter Property="MinHeight" Value="104" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{DynamicResource AppCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
  </Style>
  <Style Selector="Button.about-link /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.16" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.about-link:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppOverlaySubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBorderBrush}" />
  </Style>
  <Style Selector="Button.about-link:pressed">
    <Setter Property="Background" Value="{DynamicResource AppOverlayBrush}" />
  </Style>
  <Style Selector="Border.about-link-icon-badge">
    <Setter Property="Width" Value="42" />
    <Setter Property="Height" Value="42" />
    <Setter Property="CornerRadius" Value="15" />
    <Setter Property="Background" Value="{DynamicResource AppAccentSubtleBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="iconPacks|PackIconMingCuteIcons.about-link-icon">
    <Setter Property="Width" Value="19" />
    <Setter Property="Height" Value="19" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
  </Style>
  <Style Selector="StackPanel.about-link-content">
    <Setter Property="Spacing" Value="5" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.about-link-title">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBlock.about-link-subtitle">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextTertiaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="iconPacks|PackIconMingCuteIcons.about-link-arrow">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextTertiaryBrush}" />
    <Setter Property="Opacity" Value="0.62" />
  </Style>
  <Style Selector="Button.about-link:pointerover iconPacks|PackIconMingCuteIcons.about-link-arrow">
    <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>

  <Style Selector="Button.settings-back">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.settings-back:pointerover">
    <Setter Property="Background" Value="{DynamicResource AppOverlayBrush}" />
  </Style>
</Styles>
