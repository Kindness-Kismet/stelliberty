<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Stelliberty.Desktop.Controls"
        xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
        xmlns:loc="using:Stelliberty.Desktop.Localization"
        xmlns:views="using:Stelliberty.Desktop.Views"
        xmlns:vm="using:Stelliberty.Presentation.ViewModels"
        x:Class="Stelliberty.Desktop.MainWindow"
        x:CompileBindings="True"
        x:DataType="vm:MainWindowViewModel"
        Width="1280"
        Height="840"
        MinWidth="1040"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="36"
        TransparencyLevelHint="None"
        Background="{DynamicResource AppRootSurfaceBrush}"
        UseLayoutRounding="True"
        Title="{Binding Title}">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://stelliberty_ui/Styles/Theme.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <views:PageToViewConverter x:Key="PageToView" />
    </ResourceDictionary>
  </Window.Resources>

  <Window.Styles>
    <StyleInclude Source="avares://stelliberty_ui/Styles/ShellStyles.axaml" />
    <StyleInclude Source="avares://stelliberty_ui/Styles/PrimitivesStyles.axaml" />
    <StyleInclude Source="avares://stelliberty_ui/Styles/ScrollStyles.axaml" />
    <StyleInclude Source="avares://stelliberty_ui/Styles/ListPageStyles.axaml" />
    <StyleInclude Source="avares://stelliberty_ui/Styles/HomeStyles.axaml" />
    <StyleInclude Source="avares://stelliberty_ui/Styles/ProxyStyles.axaml" />
    <StyleInclude Source="avares://stelliberty_ui/Styles/ComboBoxStyles.axaml" />
    <StyleInclude Source="avares://stelliberty_ui/Styles/MenuStyles.axaml" />
    <StyleInclude Source="avares://stelliberty_ui/Styles/SwitchStyles.axaml" />
    <StyleInclude Source="avares://stelliberty_ui/Styles/DialogStyles.axaml" />
    <StyleInclude Source="avares://stelliberty_ui/Styles/ToastStyles.axaml" />
    <StyleInclude Source="avares://stelliberty_ui/Styles/SettingsStyles.axaml" />
  </Window.Styles>

  <Grid RowDefinitions="36,*">
    <Border x:Name="TitleBarSurface"
            AutomationProperties.AutomationId="TitleBar.Root"
            Background="Transparent"
            PointerPressed="OnTitleBarPointerPressed">
      <Grid x:Name="TitleBarLayout" ColumnDefinitions="*,Auto,Auto">
        <controls:FpsCounter Grid.Column="1"
                             AutomationProperties.AutomationId="TitleBar.FpsCounter"
                             IsVisible="{Binding AppBehavior.IsTitleBarFpsVisible}"
                             IsHitTestVisible="False"
                             VerticalAlignment="Center"
                             Margin="0,0,10,0"
                             FontFamily="Consolas"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource AppTextSecondaryBrush}" />
        <StackPanel x:Name="CaptionButtons"
                    Grid.Column="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch">
          <Button Classes="titlebar-button"
                  AutomationProperties.AutomationId="TitleBar.MinimizeButton"
                  Click="OnMinimizeClicked">
            <Path Width="13" Height="13"
                  Data="M 2 6 L 10 6"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.4"
                  StrokeLineCap="Square" />
          </Button>
          <Button Classes="titlebar-button"
                  AutomationProperties.AutomationId="TitleBar.MaximizeButton"
                  Click="OnMaximizeClicked">
            <Grid Width="13" Height="13">
              <Rectangle x:Name="MaximizeIcon" Width="9" Height="9"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                         StrokeThickness="1.25" />
              <Path x:Name="RestoreIcon" IsVisible="False"
                    Data="M 4 2.5 H 9.5 V 8 M 2.5 4 H 8 V 9.5 H 2.5 Z"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="1.25" />
            </Grid>
          </Button>
          <Button Classes="titlebar-button close"
                  AutomationProperties.AutomationId="TitleBar.CloseButton"
                  Click="OnCloseClicked">
            <Path Width="13" Height="13"
                  Data="M 3 3 L 9 9 M 9 3 L 3 9"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.45"
                  StrokeLineCap="Round" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="220,*" ClipToBounds="True">
      <Border AutomationProperties.AutomationId="Sidebar.Root"
              Classes="sidebar-shadow"
              Padding="12,24,12,20"
              Background="Transparent">
        <Grid RowDefinitions="Auto,*,Auto">
          <TextBlock AutomationProperties.AutomationId="Sidebar.BrandText"
                     Margin="0,4,0,28"
                     Text="{Binding Title}"
                     FontSize="20"
                     FontWeight="SemiBold"
                     HorizontalAlignment="Center"
                     Foreground="{DynamicResource AppAccentBrush}" />

          <StackPanel Grid.Row="1" Spacing="6">
            <Button Classes="nav-item"
                    Classes.selected="{Binding IsHomeSelected}"
                    AutomationProperties.AutomationId="Navigation.HomeButton"
                    Command="{Binding ShowHomeCommand}">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Classes="nav-icon-pill"><iconPacks:PackIconMingCuteIcons Classes="icon nav-icon nav-icon-home" /></Border><TextBlock Text="{Binding HomeNavText}" Classes="nav-label" VerticalAlignment="Center" FontSize="14" />
              </StackPanel>
            </Button>
            <Button Classes="nav-item"
                    Classes.selected="{Binding IsProxySelected}"
                    AutomationProperties.AutomationId="Navigation.ProxyButton"
                    Command="{Binding ShowProxyCommand}">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Classes="nav-icon-pill"><iconPacks:PackIconMingCuteIcons Classes="icon nav-icon nav-icon-proxy" /></Border><TextBlock Text="{Binding ProxyNavText}" Classes="nav-label" VerticalAlignment="Center" FontSize="14" />
              </StackPanel>
            </Button>
            <Button Classes="nav-item"
                    Classes.selected="{Binding IsConnectionsSelected}"
                    AutomationProperties.AutomationId="Navigation.ConnectionsButton"
                    Command="{Binding ShowConnectionsCommand}">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Classes="nav-icon-pill"><iconPacks:PackIconMingCuteIcons Classes="icon nav-icon nav-icon-connections" /></Border><TextBlock Text="{Binding ConnectionsNavText}" Classes="nav-label" VerticalAlignment="Center" FontSize="14" />
              </StackPanel>
            </Button>
            <Button Classes="nav-item"
                    Classes.selected="{Binding IsCoreLogsSelected}"
                    AutomationProperties.AutomationId="Navigation.CoreLogsButton"
                    Command="{Binding ShowCoreLogsCommand}">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Classes="nav-icon-pill"><iconPacks:PackIconMingCuteIcons Classes="icon nav-icon nav-icon-log" /></Border><TextBlock Text="{Binding CoreLogsNavText}" Classes="nav-label" VerticalAlignment="Center" FontSize="14" />
              </StackPanel>
            </Button>
            <Button Classes="nav-item"
                    Classes.selected="{Binding IsRulesSelected}"
                    AutomationProperties.AutomationId="Navigation.RulesButton"
                    Command="{Binding ShowRulesCommand}">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Classes="nav-icon-pill"><iconPacks:PackIconMingCuteIcons Classes="icon nav-icon nav-icon-rules" /></Border><TextBlock Text="{Binding RulesNavText}" Classes="nav-label" VerticalAlignment="Center" FontSize="14" />
              </StackPanel>
            </Button>
            <Button Classes="nav-item"
                    Classes.selected="{Binding IsSubscriptionsSelected}"
                    AutomationProperties.AutomationId="Navigation.SubscriptionsButton"
                    Command="{Binding ShowSubscriptionsCommand}">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Classes="nav-icon-pill"><iconPacks:PackIconMingCuteIcons Classes="icon nav-icon nav-icon-subscription" /></Border><TextBlock Text="{Binding SubscriptionsNavText}" Classes="nav-label" VerticalAlignment="Center" FontSize="14" />
              </StackPanel>
            </Button>
            <Button Classes="nav-item"
                    Classes.selected="{Binding IsOverridesSelected}"
                    AutomationProperties.AutomationId="Navigation.OverridesButton"
                    Command="{Binding ShowOverridesCommand}">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Classes="nav-icon-pill"><iconPacks:PackIconMingCuteIcons Classes="icon nav-icon nav-icon-overrides" /></Border><TextBlock Text="{Binding OverridesNavText}" Classes="nav-label" VerticalAlignment="Center" FontSize="14" />
              </StackPanel>
            </Button>
          </StackPanel>

          <Button Grid.Row="2"
                  Classes="nav-item"
                  Classes.selected="{Binding IsSettingsSelected}"
                  AutomationProperties.AutomationId="Navigation.SettingsButton"
                  Command="{Binding ShowSettingsCommand}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Classes="nav-icon-pill"><iconPacks:PackIconMingCuteIcons Classes="icon nav-icon nav-icon-settings" /></Border><TextBlock Text="{Binding SettingsNavText}" Classes="nav-label" VerticalAlignment="Center" FontSize="14" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>

      <Border Grid.Column="1"
              Classes="content-host"
              Classes.settings="{Binding IsSettingsSelected}"
              Background="Transparent">
          <Grid>
            <ContentControl x:Name="HomePageHost" Classes="page-host" />
            <ContentControl x:Name="ProxyPageHost" Classes="page-host" />
            <ContentControl x:Name="ConnectionsPageHost" Classes="page-host" />
            <ContentControl x:Name="CoreLogsPageHost" Classes="page-host" />
            <ContentControl x:Name="RulesPageHost" Classes="page-host" />
            <ContentControl x:Name="SubscriptionsPageHost" Classes="page-host" />
            <ContentControl x:Name="OverridesPageHost" Classes="page-host" />
            <ContentControl x:Name="SettingsPageHost" Classes="page-host" />
            <!-- 加载层只拦截内容区，导航仍可切换页面。 -->
            <Border x:Name="PageLoadingOverlay"
                    ZIndex="50"
                    Opacity="0"
                    IsHitTestVisible="False"
                    Background="Transparent"
                    AutomationProperties.AutomationId="Shell.PageLoadingOverlay">
              <controls:PageLoadingIndicator x:Name="PageLoadingIndicator"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Center"
                                             Height="140"
                                             AutomationProperties.AutomationId="Shell.PageLoadingIndicator" />
            </Border>
          </Grid>
      </Border>
    </Grid>

    <controls:OverlayDialogHost x:Name="DialogHost"
                                Grid.RowSpan="2" />

    <views:SubscriptionProviderDialog Grid.RowSpan="2" DataContext="{Binding SubscriptionPage.Provider}" />

    <controls:OverlayDialogHost x:Name="UpdateDialogHost"
                                Grid.RowSpan="2"
                                AutomationProperties.AutomationId="Settings.UpdateDialogOverlay"
                                IsOpen="{Binding Update.IsUpdateDialogVisible}">
      <controls:OverlayDialogHost.DialogContent>
        <controls:DialogPanel PanelWidth="500"
                              ContentPadding="0"
                              AutomationProperties.AutomationId="Settings.UpdateDialog"
                              IsOpen="{Binding Update.IsUpdateDialogVisible}">
          <controls:DialogPanel.DialogContent>
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="18">
              <!-- 标题栏：徽章 + 标题 + 副说明，右上角关闭 -->
              <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Margin="24,24,24,0">
                <Border Classes="surface-card-badge" VerticalAlignment="Top">
                  <iconPacks:PackIconMingCuteIcons Width="20" Height="20" Kind="DownloadLine"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                  <TextBlock Classes="dialog-title"
                             Text="{loc:Loc Settings.Update.Dialog.Title}" />
                  <TextBlock Classes="dialog-subtitle"
                             Text="{loc:Loc Settings.Update.Dialog.Message}"
                             TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="2"
                        Classes="dialog-close"
                        VerticalAlignment="Top"
                        AutomationProperties.AutomationId="Settings.UpdateDialog.CloseButton"
                        Command="{Binding Update.CloseUpdateDialogCommand}">
                  <iconPacks:PackIconMingCuteIcons Width="16" Height="16" Kind="CloseFill" />
                </Button>
              </Grid>

              <!-- 版本对比：旧版 → 新版，新版加 .accent 强调 -->
              <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*" ColumnSpacing="12" Margin="24,0,24,0">
                <Border Classes="update-version-slot">
                  <StackPanel Spacing="3">
                    <TextBlock Classes="uv-label" Text="{loc:Loc Settings.Update.CurrentVersion}" />
                    <TextBlock Classes="uv-value"
                               AutomationProperties.AutomationId="Settings.UpdateDialog.CurrentVersionText"
                               Text="{Binding Settings.AppVersionText}" />
                  </StackPanel>
                </Border>
                <iconPacks:PackIconMingCuteIcons Grid.Column="1" Width="18" Height="18" Kind="ArrowRightLine"
                                                 Foreground="{DynamicResource AppTextTertiaryBrush}"
                                                 VerticalAlignment="Center" />
                <Border Grid.Column="2" Classes="update-version-slot accent">
                  <StackPanel Spacing="3">
                    <TextBlock Classes="uv-label" Text="{loc:Loc Settings.Update.LatestVersion}" />
                    <TextBlock Classes="uv-value"
                               AutomationProperties.AutomationId="Settings.UpdateDialog.LatestVersionText"
                               Text="{Binding Update.LatestVersionText}" />
                  </StackPanel>
                </Border>
              </Grid>

              <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"
                          HorizontalAlignment="Right" Margin="24,0,24,24">
                <Button Classes="dialog-secondary"
                        AutomationProperties.AutomationId="Settings.UpdateDialog.LaterButton"
                        Command="{Binding Update.CloseUpdateDialogCommand}"
                        Content="{loc:Loc Common.Close}" />
                <Button Classes="dialog-primary"
                        AutomationProperties.AutomationId="Settings.UpdateDialog.OpenReleaseButton"
                        IsVisible="{Binding Update.CanOpenLatestRelease}"
                        Tag="{Binding Update.LatestReleaseUrl}"
                        Click="OnOpenUpdateReleaseClicked"
                        Content="{loc:Loc Settings.Update.OpenRelease}" />
              </StackPanel>
            </Grid>
          </controls:DialogPanel.DialogContent>
        </controls:DialogPanel>
      </controls:OverlayDialogHost.DialogContent>
    </controls:OverlayDialogHost>

    <controls:ToastNotification Grid.RowSpan="2"
                                IsOpen="{Binding IsToastVisible}"
                                Type="{Binding ToastType}"
                                Message="{Binding ToastMessage}" />
  </Grid>
</Window>
