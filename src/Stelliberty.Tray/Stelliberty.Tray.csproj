<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>$(AppName)</AssemblyName>
    <Version>$(AppVersion)</Version>
    <ApplicationIcon>..\Stelliberty.Desktop\Assets\win\app_icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="12.1.2" PrivateAssets="All" Publish="True" />
    <PackageReference Include="Semi.Avalonia" Version="12.1.0.1" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stelliberty.Application\Stelliberty.Application.csproj" />
    <ProjectReference Include="..\Stelliberty.Infrastructure\Stelliberty.Infrastructure.csproj" />
    <ProjectReference Include="..\Stelliberty.Native\Stelliberty.Native.csproj" />
  </ItemGroup>

  <!-- 托盘只共享展示规则与资源，不加载页面 ViewModel。 -->
  <ItemGroup>
    <Compile Include="..\Stelliberty.Presentation\Proxies\ProxyDelayPresentation.cs" Link="Proxies\ProxyDelayPresentation.cs" />
    <AvaloniaResource Include="..\Stelliberty.Desktop\Styles\StatusColors.axaml" Link="Styles\StatusColors.axaml" />
    <AvaloniaResource Include="..\Stelliberty.Desktop\Styles\ProxyDelayStyles.axaml" Link="Styles\ProxyDelayStyles.axaml" />
  </ItemGroup>

  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('win'))">
    <AvaloniaResource Include="..\Stelliberty.Desktop\Assets\win\tray\**" Link="Assets\win\tray\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('linux'))">
    <AvaloniaResource Include="..\Stelliberty.Desktop\Assets\linux\tray\**" Link="Assets\linux\tray\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('osx'))">
    <AvaloniaResource Include="..\Stelliberty.Desktop\Assets\macos\tray\**" Link="Assets\macos\tray\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
